    <!-- Outer glow (15%, 1.10x) -->
    <group android:pivotX="54" android:pivotY="54" android:scaleX="1.10" android:scaleY="1.10">
        <path android:pathData="M42,48 L66,48 Q70,48 70,54 Q70,60 66,60 L42,60 Q38,60 38,54 Q38,48 42,48 Z">
